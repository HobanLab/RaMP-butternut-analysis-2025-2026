ILM_trails_bbox <- data_ILM_sf_coords %>%
st_bbox %>%
st_as_sfc()
win <- as.owin(ILM_trails_bbox) #turning the box into a window
#boundary box
ILM_trails_bbox <- data_ILM_sf_coords %>%
st_bbox
win <- as.owin(ILM_trails_bbox) #turning the box into a window
win <- as.owin(ILM_trails_bbox) #turning the box into a window
ILM_trails_bbox <- ILM_trails_bbox %>%
st_as_sfc()
win <- as.owin(ILM_trails_bbox) #turning the box into a window
#boundary box
ILM_trails_bbox <- data_ILM_sf_coords %>%
st_bbox
win <- as.owin(ILM_trails_bbox) #turning the box into a window
