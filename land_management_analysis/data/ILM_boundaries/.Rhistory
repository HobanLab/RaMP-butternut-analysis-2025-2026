library(AICcmodavg)
library(lme4)
library(RVAideMemoire) # for function "overdisp.glmer" to test overdispersion
library(MuMIn) # for the r.squaredGLMM
library(DHARMa) # for a simulation based approach to inspection of residuals for model diagnostics
library(pscl) #zero inflated
library(tidyverse)
library(lsmeans)
library(multcompView)
library(multcomp)
library(plotrix) #std err
library(glmmTMB) #zeroinfl poisson
df <- data_liveadults
#factors: site, crown class, basswood, maple, and red cedar
df$site <- factor(df$site)
df$adult_crown_class <- factor(df$adult_crown_class)
df$basswood <- factor(df$basswood)
df$maple <- factor(df$maple)
df$red.cedar <- factor(df$red.cedar)
hist(df$adult_percent_live_canopy)
modList[["crown*basswood*maple*cedar*site"]] <- glm2 <-
glm(live_adult_canker_1stlivebranch ~ adult_crown_class*basswood*maple*red.cedar*site,
data = df,
family = quasibinomial(link = "logit"))
#square root transformation makes the live branch one kind of uniform
for (i in 1:nrow(df)){
df$adult_percent_live_canopy[i] <- df$adult_percent_live_canopy[i]/100
df$live_adult_girdle[i] <- df$live_adult_girdle[i]/100
df$live_adult_canker_1stlivebranch[i] <- df$live_adult_canker_1stlivebranch[i]/100
}
modList <- list()
modList[["crown*basswood*maple*cedar*site"]] <- glm2 <-
glm(live_adult_canker_1stlivebranch ~ adult_crown_class*basswood*maple*red.cedar*site,
data = df,
family = quasibinomial(link = "logit"))
modList[["crown*basswood*maple*cedar"]] <- glm3 <-
glm(live_adult_canker_1stlivebranch ~ adult_crown_class*basswood*maple*red.cedar,
data = df,
family = quasibinomial(link = "logit"))
modList[["crown*basswood*maple*site"]] <- glm4 <-
glm(live_adult_canker_1stlivebranch ~ adult_crown_class*basswood*maple*site,
data = df,
family = quasibinomial(link = "logit"))
modList[["crown*basswood*cedar*site"]] <- glm5 <-
glm(live_adult_canker_1stlivebranch ~ adult_crown_class*basswood*red.cedar*site,
data = df,
family = quasibinomial(link = "logit"))
modList[["crown*maple*cedar*site"]] <- glm6 <-
glm(live_adult_canker_1stlivebranch ~ adult_crown_class*maple*red.cedar*site,
data = df,
family = quasibinomial(link = "logit"))
modList[["basswood*maple*cedar*site"]] <- glm7 <-
glm(live_adult_canker_1stlivebranch ~ basswood*maple*red.cedar*site,
data = df,
family = quasibinomial(link = "logit"))
modList[["adult_crown_class*basswood*maple*red.cedar+site"]] <- glm8 <-
glm(live_adult_canker_1stlivebranch ~ adult_crown_class*basswood*maple*red.cedar+site,
data = df,
family = quasibinomial(link = "logit"))
modList[["adult_crown_class*basswood*maple*site+red.cedar"]] <- glm9 <-
glm(live_adult_canker_1stlivebranch ~ adult_crown_class*basswood*maple*site+red.cedar,
data = df,
family = quasibinomial(link = "logit"))
modList[["adult_crown_class*basswood*red.cedar*site+maple"]] <- glm10 <-
glm(live_adult_canker_1stlivebranch ~ adult_crown_class*basswood*red.cedar*site+maple,
data = df,
family = quasibinomial(link = "logit"))
modList[["adult_crown_class*maple*red.cedar*site+basswood"]] <- glm11 <-
glm(live_adult_canker_1stlivebranch ~ adult_crown_class*maple*red.cedar*site+basswood,
data = df,
family = quasibinomial(link = "logit"))
modList[["basswood*maple*red.cedar*site+adult_crown_class"]] <- glm12 <-
glm(live_adult_canker_1stlivebranch ~ basswood*maple*red.cedar*site+adult_crown_class,
data = df,
family = quasibinomial(link = "logit"))
modList[["adult_crown_class*basswood*maple+red.cedar+site"]] <- glm13 <-
glm(live_adult_canker_1stlivebranch ~ adult_crown_class*basswood*maple+red.cedar+site,
data = df,
family = quasibinomial(link = "logit"))
modList[["adult_crown_class*basswood*red.cedar+maple+site"]] <- glm14 <-
glm(live_adult_canker_1stlivebranch ~ adult_crown_class*basswood*red.cedar+maple+site,
data = df,
family = quasibinomial(link = "logit"))
modList[["adult_crown_class*maple*red.cedar+basswood+site"]] <- glm15 <-
glm(live_adult_canker_1stlivebranch ~ adult_crown_class*maple*red.cedar+basswood+site,
data = df,
family = quasibinomial(link = "logit"))
#....
#there are many of these iterations with two, three, etc. not interacting
modList[["adult_crown_class+maple+red.cedar+basswood+site"]] <- glm16 <-
glm(live_adult_canker_1stlivebranch ~ adult_crown_class+maple+red.cedar+basswood+site,
data = df,
family = quasibinomial(link = "logit"))
#then you start dropping terms all together one by one
modList[["1"]] <- glm16 <-
glm(live_adult_canker_1stlivebranch ~ 1,
data = df,
family = quasibinomial(link = "logit"))
## Compare models
aictab(modList)
QAICc(glm2)
QAICc(glm2,1)
QAICc(glm2, chat=1)
QAICc(glm2, chat=2)
View(glm10)
hacked.quasibinomial <- function(...) {
res <- quasibinomial(...)
res$aic <- binomial(...)$aic
res
}
QAICc(update(glm2, family = hacked.quasibinomial), chat = chat)
QAICc(update(glm2, family = hacked.quasibinomial), chat = 2)
glmtest <- glm(adult_percent_live_canopy ~ site*basswood, data=df, family=binomial)
chat <- deviance(glmtest) / df.residual(glmtest)
dredge(glmtest, rank = "QAIC", chat=chat)
dredge(glmtest, rank = "AIC")
QAIC(glmtest, chat=chat)
check_overdispersion(glmtest)
library(performance)
check_overdispersion(glmtest)
glmtest <- glm(adult_percent_live_canopy ~ site*basswood, data=df, family=quasibinomial)
chat <- deviance(glmtest) / df.residual(glmtest)
QAIC(glmtest, chat=chat)
