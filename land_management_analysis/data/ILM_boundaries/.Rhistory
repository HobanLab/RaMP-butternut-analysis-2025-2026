for (i in c(1:46, 48:nrow(data_ILMliveadults))){
if (data_ILMliveadults$adult_crown_class[i] == "NA - no canopy"){
data_ILMliveadults$adult_crown_class[i] <- "Open canopy"
}
if (data_ILMliveadults$adult_percent_live_canopy[i] <= 70 & data_ILMliveadults$live_adult_girdle[i] <= 50)
data_ILMliveadults$category[i] <- 1
if (data_ILMliveadults$adult_percent_live_canopy[i] <= 70 & data_ILMliveadults$live_adult_girdle[i] > 50)
data_ILMliveadults$category[i] <- 2
if (data_ILMliveadults$adult_percent_live_canopy[i] > 70 & data_ILMliveadults$live_adult_girdle[i] > 50)
data_ILMliveadults$category[i] <- 3
if (data_ILMliveadults$adult_percent_live_canopy[i] > 70 & data_ILMliveadults$live_adult_girdle[i] <= 50)
data_ILMliveadults$category[i] <- 4
}
